{
  "name": "AI to Figma Live Bridge",
  "id": "ai-to-figma-live-bridge-local-dev",
  "api": "1.0.0",
  "main": "code.js",
  "ui": "ui.html",
  "editorType": ["figma"],
  "networkAccess": {
    "allowedDomains": ["ws://localhost:8720", "ws://127.0.0.1:8720"],
